# --- Web portal ---
LA_HOST=127.0.0.1
LA_PORT=8787
# Public URL if you deploy behind a domain (must match the LinkedIn redirect URL)
# LA_BASE_URL=https://linkedin.example.com
# Protect the REST API (recommended when not on localhost)
# LA_API_TOKEN=change-me
# LA_DATA_DIR=~/.linkedin-agent

# --- LinkedIn developer app: https://www.linkedin.com/developers/apps ---
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Authorized redirect URL: http://localhost:8787/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608
# Set to 1 only after LinkedIn approves the Community Management API (Company Pages)
LINKEDIN_ORG_ENABLED=0
